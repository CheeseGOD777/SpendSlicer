# ─── Python ─────────────────────────────────────────────────────────────
*.pyc
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
venv/
.venv/

# ─── Node ───────────────────────────────────────────────────────────────
node_modules/
# The built dashboard is committed at spendslicer/web/static so that neither
# `pip install spendslicer` nor ./run.sh needs a Node toolchain. Vite no longer
# writes to frontend/dist; ignore it so stale local copies never get staged.
frontend/dist/

# ─── Desktop build output ───────────────────────────────────────────────
desktop/build/
desktop/dist/
*.spec.bak

# ─── Local runtime state ────────────────────────────────────────────────
exports/
.cache/
*.duckdb
*.duckdb.wal

# ─── Terraform ──────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# ─── OS / editor ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ─── Agent / assistant session state ────────────────────────────────────
.claude/
.superpowers/

# Impeccable design-tooling state: direction contracts, review screenshots,
# live-mode config. Kept on disk for future sessions, not published.
.impeccable/
frontend/.impeccable/
