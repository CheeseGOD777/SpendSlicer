<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- PyInstaller's bootloader maps its own pages and the CPython runtime
         JIT-compiles nothing but does load unsigned .so files at runtime, so
         the hardened runtime needs these two exemptions to launch at all. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Outbound HTTPS to the AWS APIs. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- The dashboard is served from a loopback listener the app itself binds. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Reads ~/.aws/credentials and ~/.aws/config. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
